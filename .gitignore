# ==============================================================================
# TerraScout AI — .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
ENV/

# Environment variables & secrets (CRITICAL: Samsung audit 17/11 compliance)
.env
.env.*
!.env.example
*.secret
*.key
*.pem
credentials.json
token.json

# Apify Actor local storage & artifacts
storage/
apify_storage/
.apify/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Pytest / Coverage / Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# IDEs & Editor configurations
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Temporary & scratch files
tmp/
temp/
scratch/
*.log
.~lock.*