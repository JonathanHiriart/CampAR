{
  "name": "TerraScout AI - Producto 1 (ETL -> Drive -> EDA JSON -> Google Sheets)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-token",
              "name": "apify_token",
              "value": "PEGA_TU_APIFY_TOKEN_AQUI",
              "type": "string"
            },
            {
              "id": "cfg-raw",
              "name": "raw_workbook_url",
              "value": "",
              "type": "string"
            },
            {
              "id": "cfg-limpio",
              "name": "folder_limpio_id",
              "value": "root",
              "type": "string"
            },
            {
              "id": "cfg-sheet-id",
              "name": "google_sheet_id",
              "value": "PEGA_EL_ID_DE_TU_GOOGLE_SHEET_AQUI",
              "type": "string"
            },
            {
              "id": "cfg-sheet-tab",
              "name": "google_sheet_tab",
              "value": "Datos",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config-2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "clear",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.google_sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.google_sheet_tab }}"
        },
        "clear": "wholeSheet",
        "keepFirstRow": true
      },
      "id": "sheets-clear-3",
      "name": "0. LIMPIAR Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/ypvpGbmD1vpqraNXA/run-sync?outputRecordKey=dataset_limpio.csv",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.apify_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw_workbook_url: $('Config').first().json.raw_workbook_url }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "apify-etl-4",
      "name": "1. APIFY ETL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 0]
    },
    {
      "parameters": {
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "dataset_limpio.csv",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.folder_limpio_id }}"
        },
        "options": {}
      },
      "id": "drive-limpio-5",
      "name": "2. DRIVE Dataset Limpio",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [920, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/YZH8ti7zjLt6410Hx/run-sync-get-dataset-items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.apify_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dataset_limpio_url: 'https://drive.google.com/file/d/' + $json.id + '/view', raw_workbook_url: $('Config').first().json.raw_workbook_url, top_oportunidades_limit: 250 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "apify-eda-6",
      "name": "3. APIFY EDA (JSON)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.google_sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.google_sheet_tab }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "sheets-append-7",
      "name": "4. GOOGLE SHEETS Dashboard",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1400, 0]
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "0. LIMPIAR Google Sheet", "type": "main", "index": 0 }]]
    },
    "0. LIMPIAR Google Sheet": {
      "main": [[{ "node": "1. APIFY ETL", "type": "main", "index": 0 }]]
    },
    "1. APIFY ETL": {
      "main": [[{ "node": "2. DRIVE Dataset Limpio", "type": "main", "index": 0 }]]
    },
    "2. DRIVE Dataset Limpio": {
      "main": [[{ "node": "3. APIFY EDA (JSON)", "type": "main", "index": 0 }]]
    },
    "3. APIFY EDA (JSON)": {
      "main": [[{ "node": "4. GOOGLE SHEETS Dashboard", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
