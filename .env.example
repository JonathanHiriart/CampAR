# ==============================================================================
# TerraScout & EcoCamp AI — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Apify API Access
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Make.com (Integromat) Webhook URL for Orchestration Pipeline
# Target webhook configured in the Make scenario trigger node
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Business & Financial Exchange Configuration
# Official / MEP exchange rate ARS/USD used for property pricing normalization
TIPO_CAMBIO_ARS_USD=1280.0

# Execution Environment: development | staging | production
ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
